# Public site origin, used for absolute Open Graph image URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://lotusattune.com

# Supabase connection string. Supabase dashboard → Project Settings → Database →
# Connection string → **Transaction pooler** (port 6543). Either name works.
POSTGRES_URL=

# Studio dashboard access. STUDIO_PASSWORD gates /studio; SESSION_SECRET signs
# the session cookie. Generate the secret with: openssl rand -base64 32
STUDIO_PASSWORD=
SESSION_SECRET=

# Client review mode. Share https://<site>/?review=<token> and the client can
# pin notes directly onto the live site. Unset means review mode is refused.
REVIEW_TOKEN=
