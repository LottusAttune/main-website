# Public site origin, used for absolute Open Graph image URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://lotusattune.com

# Supabase connection string. Supabase dashboard → Project Settings → Database →
# Connection string → **Transaction pooler** (port 6543). Either name works.
POSTGRES_URL=

# Studio dashboard access. STUDIO_PASSWORD gates /studio; SESSION_SECRET signs
# the session cookie. Generate the secret with: openssl rand -base64 32
STUDIO_PASSWORD=
SESSION_SECRET=

# Resend API key for every automatic email: booking received, proposals,
# invoices, receipts, confirmations, reminders, gift certificates, discovery
# call confirmations. Resend dashboard → API Keys → Create API Key (Sending
# access), and verify lotusattune.com under Domains so mail is not rejected.
RESEND_API_KEY=

# PDFShift renders proposals, invoices and gift certificates to PDF.
# PDFShift dashboard → API keys. Without it, documents still send with their
# content inline and the online copy; only the PDF attachment is missing.
# PDFSHIFT_SANDBOX=1 renders watermarked test PDFs without spending credits.
PDFSHIFT_API_KEY=
PDFSHIFT_SANDBOX=

# Stripe, for card payments on invoices (full, or a 50% deposit whose balance
# is charged automatically before the session) and late-cancellation fees.
# Stripe dashboard → Developers → API keys (secret key), then Developers →
# Webhooks → add https://lotusattune.com/api/stripe/webhook listening for
# checkout.session.completed, and paste its signing secret below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Protects the daily job (/api/cron/daily: reminders, deposit balances).
# Vercel sends it automatically once set; generate with: openssl rand -hex 32
CRON_SECRET=

# Adds bookings and discovery calls to Silvana's own Google Calendar.
# One-time setup: a Google Cloud OAuth client (Web application type, with
# https://developers.google.com/oauthplayground as an authorized redirect
# URI) authorized for the https://www.googleapis.com/auth/calendar.events
# scope via the OAuth Playground, publishing the app first so the refresh
# token doesn't expire after 7 days.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

